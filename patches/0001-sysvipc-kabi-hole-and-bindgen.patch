@@ -5,7 +5,7 @@
 struct sem_undo_list;
 
 struct sysv_sem {
-#ifdef CONFIG_SYSVIPC
+#if defined(CONFIG_SYSVIPC) && !defined(__BINDGEN__)
 	struct sem_undo_list *undo_list;
 #endif
 };
