new file mode 100644
index 000000000..3d2535bdf
--- /dev/null
+++ b/arch/arm64/configs/droidspaces_defconfig
@@ -0,0 +1,11 @@
+# Droidspaces container support for android16-6.12 GKI (post defconfig fragment).
+# Applied with: --defconfig_fragment=//common:arch/arm64/configs/droidspaces_defconfig
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_IPC_NS=y
+CONFIG_PID_NS=y
+CONFIG_USER_NS=y
+CONFIG_DEVTMPFS=y
+# CONFIG_DEVTMPFS_MOUNT is not set
+# Keep trusting the stock GKI build key so stock system_dlkm modules stay sig_ok.
+CONFIG_SYSTEM_TRUSTED_KEYS="certs/stock_gki_signing_cert.pem"
